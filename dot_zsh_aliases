# general
alias -- g=lazygit
alias -- gs='git status'
alias -- r='chezmoi apply --force && kitty @ load-config && source  ~/.zshrc'
alias -- ls='lsd -1'

# config dir
alias -- cdc='cd ~/.config/'

# open directory with oil
alias -- o='nvim -c 'Oil .' '

# nvim
alias -- e=nvim

# chezmoi
alias -- cddf='cd ~/.local/share/chezmoi/'
